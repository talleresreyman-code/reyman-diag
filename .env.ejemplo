# Copiar a .env y rellenar. Nunca subir .env a GitHub.
DB_PASSWORD=cambiar
AUTH_MODE=app-reyman
DEFAULT_TENANT=reyman

# App Reyman (mismo VPS, misma red de Docker que el Caddy de n8n)
PROXY_NETWORK=n8n_default
APP_REYMAN_URL=http://reyman-app:3000
APP_REYMAN_PUBLIC_URL=https://app.talleresreyman.es
APP_REYMAN_YO=/api/yo
APP_REYMAN_OTS=/api/diag/ots
APP_REYMAN_API_KEY=

# n8n
N8N_CORREO_URL=https://n8n.talleresreyman.es/webhook/reyman-app-correo
N8N_CLAVE=
DIAG_INGEST_KEY=
CORREO_COPIA=talleresreyman@gmail.com

# IA (Claude). Precios por millón de tokens en USD: comprobar los vigentes antes de activar.
ANTHROPIC_API_KEY=
IA_MODELO=claude-sonnet-5-5
IA_PRECIO_ENTRADA_USD_MTOK=3
IA_PRECIO_SALIDA_USD_MTOK=15
USD_A_EUR=0.92
IA_TOPE_MES_EUR=15

# Reyman Connect (app de cliente)
# Orígenes de la app nativa que pueden enviar avisos (iPhone: capacitor://localhost · Android: https://localhost)
CONNECT_ORIGENES=capacitor://localhost,https://localhost,http://localhost
# Webhook de n8n para avisar por Telegram de cada aviso nuevo (opcional)
N8N_CONNECT_URL=
