{
  "appId": "es.talleresreyman.app",
  "appName": "Reyman",
  "webDir": "www",
  "server": {
    "url": "https://app.talleresreyman.es",
    "allowNavigation": [
      "talleresreyman.es",
      "*.talleresreyman.es"
    ],
    "errorPath": "sin-conexion.html"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#1F2732",
    "appendUserAgent": "ReymanApp/ubicacion"
  },
  "android": {
    "backgroundColor": "#1F2732",
    "appendUserAgent": "ReymanApp/ubicacion"
  },
  "plugins": {
    "SystemBars": {
      "initialViewportFitValueHint": "cover"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
